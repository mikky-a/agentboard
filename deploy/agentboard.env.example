# Agent Board settings. Copy to /etc/agentboard.env with your user name filled in
# and keep it private (it holds the board password and the bot token):
#   sed "s/YOUR_USER/$USER/g" deploy/agentboard.env.example | sudo tee /etc/agentboard.env >/dev/null
#   sudo chmod 600 /etc/agentboard.env
# then edit. Restart the service after any change.

# Listen on localhost only; the outside world reaches the board through the
# HTTPS reverse proxy (Caddy, nginx). Do not expose this port directly.
AGENTBOARD_HOST=127.0.0.1
AGENTBOARD_PORT=8787

# Password for the web board. Make it long and random: openssl rand -hex 24
# Required: the board refuses to start with AGENTBOARD_URL set and no token.
AGENTBOARD_TOKEN=

# Public address of the board. Telegram notifications link to the card here.
AGENTBOARD_URL=https://board.example.com

# Board state, notifier state and files sent from Telegram. Keep it outside the
# git checkout.
AGENTBOARD_DATA=/home/YOUR_USER/.agentboard

# Folders the "+ agent" picker lists projects from, colon-separated.
AGENTBOARD_DIRS=/home/YOUR_USER/projects

# Telegram: a bot of your own from @BotFather, used by nothing else (the board
# long-polls it, and Telegram allows only one poller per bot), and the id of
# your chat with it. Leave empty to run without Telegram.
AGENTBOARD_TG_TOKEN=
AGENTBOARD_TG_CHAT=
